# Copy to .env. Only the API keys are secret; everything else is a setting.

# The decision model answers typed questions with probabilities (the System One protocol). Set the
# key of every provider you want to use; each is offered in the interface as "<provider>:<model>".
# Without any key the studio still runs offline (?offline, catalogue studies, every check).
TYPESAFE_API_KEY=            # TypeSafe AI directly: https://api.typesafe.ai (models jev-latest, jev-preview)
OPENROUTER_API_KEY=          # OpenRouter's Decisions API: every decision model it lists (Jev, Liquid d1, Perplexity, OpenAI, …)
NANO_GPT_API_KEY=            # NanoGPT: https://nano-gpt.com (typesafe/jev-latest and other decision models)
# CONJURE_API_KEY=           # any other host of the System One API, with:
# CONJURE_BASE_URL=https://decisions.example/api
# CONJURE_DECISION_PATH=/v1/systemone

# Which configured provider bare model names belong to (default: the first configured, in the order above).
# CONJURE_PROVIDER=openrouter
# The default model, as "<provider>:<model>" or a bare name on the default provider.
# CONJURE_MODEL=openrouter:~typesafe/jev-latest
# The models offered in the interface, comma-separated. Unset: every configured provider's decision models
# (TypeSafe and OpenRouter are asked for their current lists at startup).
# CONJURE_MODELS=typesafe:jev-latest,openrouter:liquid/d1,nanogpt:typesafe/jev-latest

CONJURE_PORT=3400
# Spending stops here. The ledger is .data/usage.json.
# CONJURE_BUDGET_USD=10   # optional spending cap in dollars; unset means no cap (spending is still recorded)
# Dollars per million input tokens when a provider does not report a cost (TypeSafe directly: Jev is $0.042).
# CONJURE_INPUT_USD_PER_MILLION=0.042

# Serve to other machines: bind every interface and name the hosts a browser may use.
# CONJURE_HOST=0.0.0.0
# CONJURE_ALLOWED_HOSTS=studio.local

# Optional: the Three.js ateliers repository (captnocap/three), for the six things that wrap its builders.
# Either link it as ./ateliers or point here. Without it those six are left out of the catalogue.
# CONJURE_ATELIERS_DIR=../three
