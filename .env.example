# Copy to .env. Only NANO_GPT_API_KEY is secret; everything else is a setting.

# The decision model is reached through NanoGPT (https://nano-gpt.com) with the @typesafe-ai/sdk.
# Without a key the studio still runs offline (?offline, catalogue studies, every check), it just asks no model.
NANO_GPT_API_KEY=

CONJURE_PORT=3400
CONJURE_MODEL=typesafe/jev-latest
# Models offered in the interface, comma-separated.
CONJURE_MODELS=typesafe/jev-latest,perplexity/pplx-decider-v1.1-27b,liquid/d1,llmtech/decider-4b-nvfp4,openai/gpt-6-luna-decisions
# Spending stops here. The ledger is .data/usage.json.
# CONJURE_BUDGET_USD=10   # optional spending cap in dollars; unset means no cap (spending is still recorded)
# Used only when the provider does not report a cost.
CONJURE_INPUT_USD_PER_MILLION=0.25

# Serve to other machines: bind every interface and name the hosts a browser may use.
# CONJURE_HOST=0.0.0.0
# CONJURE_ALLOWED_HOSTS=studio.local

# Optional: the Three.js ateliers repository (captnocap/three), for the six things that wrap its builders.
# Either link it as ./ateliers or point here. Without it those six are left out of the catalogue.
# CONJURE_ATELIERS_DIR=../three
